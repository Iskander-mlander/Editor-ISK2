{
    "name": "Run command",
    "trigger": "subrun",
    "description": "Ejecuta comando con subprocess",
    "body": [
        "import subprocess",
        "import shlex",
        "",
        "def run_command(cmd='${1:ls -la}', capture_output=True):",
        "    try:",
        "        if isinstance(cmd, str):",
        "            cmd = shlex.split(cmd)",
        "        result = subprocess.run(cmd,",
        "                               capture_output=capture_output,",
        "                               text=True,",
        "                               timeout=${2:10})",
        "        if result.returncode == 0:",
        "            return result.stdout",
        "        else:",
        "            print(f'Error: {result.stderr}')",
        "            return None",
        "    except subprocess.TimeoutExpired:",
        "        print('Comando timeout')",
        "        return None",
        "    except Exception as e:",
        "        print(f'Error: {e}')",
        "        return None",
        "",
        "if __name__ == '__main__':",
        "    output = run_command()",
        "    if output:",
        "        print(output)"
    ],
    "scope": "python"
}
