{
    "name": "requests GET",
    "trigger": "reqget",
    "description": "Petición HTTP GET con requests",
    "body": [
        "import requests",
        "",
        "def fetch_url(url='${1:https://api.github.com}'):",
        "    try:",
        "        response = requests.get(url, timeout=${2:10})",
        "        response.raise_for_status()",
        "        return response.json()",
        "    except requests.exceptions.RequestException as e:",
        "        print(f'Error: {e}')",
        "        return None",
        "",
        "if __name__ == '__main__':",
        "    data = fetch_url()",
        "    print(data)"
    ],
    "scope": "python"
}
